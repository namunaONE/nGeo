# GitHub Pages website (served separately, not part of package)
docs/

# Generated non-Dart bindings (npm / PyPI / CSV / GeoJSON). They are built
# from the same dataset but published separately; shipping them inside the
# Dart package would add ~1.7 MB of duplicate JSON for no Dart consumer.
bindings/

# Tooling scripts (not needed in published package)
tool/

# Companion Flutter packages. nepal_admin_widgets is published separately and
# depends on THIS package via a path dependency; shipping it inside would add
# the whole widget source plus its pubspec lock to every download.
packages/

# Raw data sources (not needed in published package)
data/_raw/
data/_stage/

# Documentation (review notes; not part of published package)
doc/

# Python tooling / venv (local only, not part of the Dart package)
_libs/
_wheels3/
_mpl/
_geo/
_tmp/
bootstrap_libs.py
make_atlas.py
prep_data.py
validate_outputs.py

# Node tooling (local only)
node_modules/
package.json
package-lock.json

# Maps / web atlas (published separately, not part of the Dart package)
maps/
Nepal_Local_Level_Atlas.pdf

# Ninth Bell media project (unrelated to this package)
the_ninth_bell/

# Selected data dumps / scratch
selected.geojson
selected.kml
selected.wkt
xls_dump.json

# Temporary files
*.dart_tool/
.packages
pubspec.lock
build/
coverage/

# IDE
.idea/
.vscode/
.DS_Store

# Git metadata
.git/
.gitignore

# Logs
*.log
